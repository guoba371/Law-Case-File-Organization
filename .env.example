# 服务器配置
# HOST 默认 127.0.0.1（仅本机访问）；需要外网直接访问端口时设为 0.0.0.0
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# 后台默认密钥；页面填写的密钥会优先使用
DEEPSEEK_API_KEY=
KIMI_API_KEY=
ZHIPU_API_KEY=

# 首页问题反馈邮件（QQ 邮箱需使用 SMTP 授权码，不是登录密码）
FEEDBACK_SMTP_HOST=smtp.qq.com
FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_USER=
FEEDBACK_SMTP_PASS=
FEEDBACK_NOTIFY_EMAIL=

# 日志级别（debug, info, warn, error）
LOG_LEVEL=info

# API 请求速率限制（每分钟请求数）
RATE_LIMIT_PER_MINUTE=100
