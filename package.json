{
  "name": "law-case-redaction-saas",
  "version": "0.1.0",
  "private": true,
  "description": "刑事案卷脱敏与内部研判",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write src/config.js src/errors.js src/logger.js src/rate-limiter.js test/infrastructure.test.js",
    "format:check": "prettier --check src/config.js src/errors.js src/logger.js src/rate-limiter.js test/infrastructure.test.js",
    "validate": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "legal",
    "case-management",
    "redaction",
    "document-generation",
    "criminal-law"
  ],
  "dependencies": {
    "@antv/g6": "5.1.1",
    "beautiful-mermaid": "1.1.3",
    "docx": "^9.15.1",
    "mammoth": "^1.9.1",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "linkedom": "0.18.12",
    "prettier": "^3.4.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
